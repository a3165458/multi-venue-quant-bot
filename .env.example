# ═══════════════════════════════════════════════════════
# Multi-Venue Quant Bot — 环境变量配置
# 复制此文件为 .env；每个 venue 使用独立前缀，保存在同一文件
# cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── 默认实盘场所 ─────────────────────────────────────
# lighter-mainnet | lighter-robinhood | arcus-mainnet | arcus-testnet | aster-mainnet
# | hyperliquid-mainnet | hyperliquid-testnet
TRADING_VENUE=arcus-mainnet

# ── Lighter Mainnet API 凭据 ─────────────────────────
LIGHTER_MAINNET_SECRET_KEY=
LIGHTER_MAINNET_ACCOUNT_INDEX=
LIGHTER_MAINNET_API_KEY_INDEX=

# ── Robinhood Chain API 凭据 ─────────────────────────
LIGHTER_ROBINHOOD_SECRET_KEY=
LIGHTER_ROBINHOOD_ACCOUNT_INDEX=
LIGHTER_ROBINHOOD_API_KEY_INDEX=

# ── Arcus Mainnet API 凭据 ────────────────────────────
# API_KEY 与 API_SIGNING_KEY 是 Arcus 页面显示的两个独立字段
# SIGNING_KEY 为 Ed25519 seed（64 位 hex），切勿使用钱包私钥
ARCUS_MAINNET_API_KEY=
ARCUS_MAINNET_SIGNING_KEY=
ARCUS_MAINNET_ADDRESS=
ARCUS_MAINNET_ACCOUNT_INDEX=0

# ── Arcus Testnet API 凭据 ────────────────────────────
ARCUS_TESTNET_API_KEY=
ARCUS_TESTNET_SIGNING_KEY=
ARCUS_TESTNET_ADDRESS=
ARCUS_TESTNET_ACCOUNT_INDEX=0

# ── Aster Pro Futures V3 Mainnet 凭据 ─────────────────
# SIGNER_ADDRESS 是 Pro API Wallet 的公钥地址。
# SIGNER_PRIVATE_KEY 只用于 API Wallet 签名，切勿填写子账户或资金钱包私钥。
ASTER_MAINNET_SIGNER_ADDRESS=
ASTER_MAINNET_SIGNER_PRIVATE_KEY=

# ── Hyperliquid Mainnet 凭据 ──────────────────────────
# ACCOUNT_ADDRESS 是主账户地址（余额/订单/成交都按它查询）。
# SIGNER_PRIVATE_KEY 推荐使用在 https://app.hyperliquid.xyz/API 授权的
# API Wallet（agent）私钥；也可以是主账户私钥，但不建议。
# HIP-3（entropy.io 等 builder dex）资产使用独立隔离保证金，
# 需先在对应 dex 内存入 USDC。
HYPERLIQUID_MAINNET_ACCOUNT_ADDRESS=
HYPERLIQUID_MAINNET_SIGNER_PRIVATE_KEY=

# ── Hyperliquid Testnet 凭据 ──────────────────────────
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET_SIGNER_PRIVATE_KEY=

# ── 系统配置 ──────────────────────────────────────────
RUST_LOG=info
TOKIO_WORKER_THREADS=4

# ── 可选: lighter-signer.so 路径 ─────────────────────
# 如不设置，程序会依次查找:
#   1. 可执行文件同目录
#   2. 当前工作目录 ./lighter-signer.so
#   3. Docker 容器内 /app/lighter-signer.so
# LIGHTER_SIGNER_PATH=/path/to/lighter-signer.so
