# ═══════════════════════════════════════════════════════
# Lighter Quant Bot — 环境变量配置
# 复制此文件为 .env；两个网络使用独立前缀，保存在同一文件
# cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── 默认实盘场所 ─────────────────────────────────────
# lighter-mainnet | lighter-robinhood | arcus-mainnet | arcus-testnet
TRADING_VENUE=lighter-mainnet

# ── Lighter Mainnet API 凭据 ─────────────────────────
LIGHTER_MAINNET_SECRET_KEY=
LIGHTER_MAINNET_ACCOUNT_INDEX=
LIGHTER_MAINNET_API_KEY_INDEX=

# ── Robinhood Chain API 凭据 ─────────────────────────
LIGHTER_ROBINHOOD_SECRET_KEY=
LIGHTER_ROBINHOOD_ACCOUNT_INDEX=
LIGHTER_ROBINHOOD_API_KEY_INDEX=

# ── Arcus Mainnet API 凭据 ────────────────────────────
# API_KEY 与 API_SIGNING_KEY 是 Arcus 页面显示的两个独立字段
# SIGNING_KEY 为 Ed25519 seed（64 位 hex），切勿使用钱包私钥
ARCUS_MAINNET_API_KEY=
ARCUS_MAINNET_SIGNING_KEY=
ARCUS_MAINNET_ADDRESS=
ARCUS_MAINNET_ACCOUNT_INDEX=0

# ── Arcus Testnet API 凭据 ────────────────────────────
ARCUS_TESTNET_API_KEY=
ARCUS_TESTNET_SIGNING_KEY=
ARCUS_TESTNET_ADDRESS=
ARCUS_TESTNET_ACCOUNT_INDEX=0

# ── 系统配置 ──────────────────────────────────────────
RUST_LOG=info
TOKIO_WORKER_THREADS=4

# ── 可选: lighter-signer.so 路径 ─────────────────────
# 如不设置，程序会依次查找:
#   1. 可执行文件同目录
#   2. 当前工作目录 ./lighter-signer.so
#   3. Docker 容器内 /app/lighter-signer.so
# LIGHTER_SIGNER_PATH=/path/to/lighter-signer.so
